[ req ]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn
[ dn ]
C = SG
ST = Singapore
L = Singapore
O = MyOrg
OU = Users
CN = client1
[ req_ext ]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature
extendedKeyUsage = clientAuth
[ alt_names ]
DNS.1 = client1.local
email.1 = client1@myorg.com
IP.1 = 172.16.160.108
