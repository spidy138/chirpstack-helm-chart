[ req ]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[ dn ]
C = SG
ST = Singapore
L = Singapore
O = MyOrg
OU = IT
CN = 57.151.79.18

[ req_ext ]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[ alt_names ]
DNS.1 = vernemq.vernemq
DNS.2 = vernemq.local
DNS.3 = vernemq.vernemq.svc
DNS.4 = vernemq.vernemq.svc.cluster.local
IP.1 = 127.0.0.1
IP.2 = 57.151.79.18 